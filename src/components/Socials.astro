---
import { SOCIALS } from "@/constants";

export interface Props {
  tone?: "light" | "dark";
}
const { tone = "light" } = Astro.props;
---

<ul class="flex items-center gap-2" aria-label="Social links">
  {
    SOCIALS.map(social => (
      <li>
        <a
          href={social.href}
          title={social.linkTitle}
          target={social.href.startsWith("http") ? "_blank" : undefined}
          rel={
            social.href.startsWith("http") ? "noopener noreferrer" : undefined
          }
          class:list={[
            "grid size-11 place-items-center rounded-full border-[1.5px] transition-transform hover:-translate-y-0.5",
            tone === "dark"
              ? "border-white/25 text-paper hover:bg-white/10"
              : "border-ink text-ink hover:bg-white",
          ]}
        >
          <social.icon class="size-5 fill-transparent stroke-current stroke-2" />
          <span class="sr-only">{social.linkTitle}</span>
        </a>
      </li>
    ))
  }
</ul>
