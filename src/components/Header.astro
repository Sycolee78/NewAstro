---
import { SITE } from "@/config";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const links = [
  { href: "/projects", label: "Projects" },
  { href: "/certifications", label: "Certifications" },
  { href: "/about", label: "About" },
  { href: "/#contact", label: "Contact" },
];
const isActive = (href: string) =>
  href !== "/#contact" && (path === href || path.startsWith(`${href}/`));
---

<header
  class="sticky top-0 z-50 border-b border-line/70 bg-paper/90 backdrop-blur-md"
>
  <div class="container-x flex h-[72px] items-center justify-between gap-6">
    <a
      href="/"
      class="group flex items-center gap-3 no-underline"
      aria-label={`${SITE.author} — home`}
    >
      <span
        class="relative grid size-11 place-items-center rounded-full border-[3px] border-ink font-display text-[15px] font-extrabold text-ink"
      >
        EB
        <span
          class="absolute -top-1 -right-1 size-3 rounded-full bg-ember ring-2 ring-paper"
          aria-hidden="true"></span>
      </span>
      <span
        class="hidden font-display text-lg leading-none font-extrabold tracking-tight sm:block"
      >
        Emmanuel Buruvuru
      </span>
    </a>

    <nav aria-label="Main" class="hidden items-center gap-7 md:flex">
      {
        links.map(l => (
          <a
            href={l.href}
            aria-current={isActive(l.href) ? "page" : undefined}
            class:list={[
              "text-[15px] font-medium no-underline transition-colors hover:text-ember-deep",
              isActive(l.href) &&
                "font-bold underline decoration-ember decoration-[3px] underline-offset-[10px]",
            ]}
          >
            {l.label}
          </a>
        ))
      }
      <a
        href="https://availafrica.com"
        class="btn-dark !min-h-11 !px-5 !text-sm"
        target="_blank"
        rel="noopener"
      >
        Avail Africa <span aria-hidden="true">↗</span>
      </a>
    </nav>

    <details class="menu md:hidden">
      <summary
        class="grid size-11 place-items-center rounded-full bg-ink text-paper"
        aria-label="Menu"
      >
        <span class="flex flex-col gap-[5px]" aria-hidden="true">
          <span class="block h-[2.5px] w-[18px] rounded bg-paper"></span>
          <span class="block h-[2.5px] w-[18px] rounded bg-paper"></span>
        </span>
      </summary>
      <nav
        aria-label="Main"
        class="absolute inset-x-0 top-[72px] border-b border-line bg-paper px-4 pt-2 pb-6 shadow-[0_18px_40px_rgba(21,18,46,.12)]"
      >
        <ul class="flex flex-col">
          <li>
            <a
              href="/"
              class="block border-b border-line py-3.5 font-display text-2xl font-bold no-underline"
              >Home</a
            >
          </li>
          {
            links.map(l => (
              <li>
                <a
                  href={l.href}
                  aria-current={isActive(l.href) ? "page" : undefined}
                  class:list={[
                    "block border-b border-line py-3.5 font-display text-2xl font-bold no-underline",
                    isActive(l.href) && "text-ember-deep",
                  ]}
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a
          href="https://availafrica.com"
          class="mt-5 btn-dark"
          target="_blank"
          rel="noopener"
        >
          Avail Africa <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </details>
  </div>
</header>

<script>
  // Progressive enhancement: close the menu after choosing a link or pressing Escape.
  const menu = document.querySelector<HTMLDetailsElement>("details.menu");
  menu
    ?.querySelectorAll("a")
    .forEach(a =>
      a.addEventListener("click", () => menu.removeAttribute("open"))
    );
  document.addEventListener("keydown", e => {
    if (e.key === "Escape" && menu?.open) {
      menu.removeAttribute("open");
      menu.querySelector("summary")?.focus();
    }
  });
</script>
