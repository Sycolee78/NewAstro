---
// src/components/ProjectCard.astro
import IconGitHub from "./icons/IconGitHub.astro";
import StatusPill from "./StatusPill.astro";
import type { Project } from "@/data/projects";

export interface Props {
  project: Project;
  /** Large full-width card (used for Avail Africa on the home page). */
  spotlight?: boolean;
}

const { project, spotlight = false } = Astro.props;
const {
  title,
  status,
  description,
  slug,
  githubUrl,
  liveUrl,
  liveLabel,
  tags = [],
  external,
  accent,
} = project;

const href = external ? liveUrl : `/projects/${slug}/`;
const linkLabel = external ? (liveLabel ?? "Visit") : "Case study";
const accentBar =
  accent === "ember"
    ? "bg-ember"
    : accent === "sprint"
      ? "bg-sprint"
      : "bg-ink";
---

{
  spotlight ? (
    <article class="relative overflow-hidden rounded-[28px] bg-ember p-7 text-ink sm:p-10">
      <span
        class="ring-motif -top-24 -right-20 size-[300px] border-[52px] border-white/25"
        aria-hidden="true"
      />
      <div class="relative flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div class="max-w-2xl">
          <div class="flex flex-wrap items-center gap-3">
            <span class="eyebrow">Founder &amp; CEO · My company</span>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-white/60 px-3 py-1 text-xs font-bold">
              <span
                class="size-1.5 rounded-full bg-current"
                aria-hidden="true"
              />
              {status}
            </span>
          </div>
          <h3 class="mt-3 text-4xl leading-none font-extrabold tracking-tight sm:text-5xl">
            {title}
          </h3>
          <p class="mt-4 text-[17px] leading-relaxed">{description}</p>
          <ul class="mt-5 flex flex-wrap gap-2" aria-label="Technologies">
            {tags.map(t => (
              <li class="rounded-full bg-white/55 px-3 py-1 text-xs font-bold">
                {t}
              </li>
            ))}
          </ul>
        </div>
        <a
          href={href}
          target="_blank"
          rel="noopener"
          class="btn-dark shrink-0 self-start md:self-end"
        >
          {linkLabel} <span aria-hidden="true">↗</span>
        </a>
      </div>
    </article>
  ) : (
    <article class="group relative flex flex-col overflow-hidden rounded-[24px] border-[1.5px] border-line bg-white p-6 transition-transform duration-200 hover:-translate-y-1 sm:p-7">
      <span
        class:list={["absolute inset-x-0 top-0 h-1.5", accentBar]}
        aria-hidden="true"
      />
      <div class="flex items-start justify-between gap-3">
        <div>
          <h3 class="text-[22px] leading-tight font-bold">
            <a
              href={href}
              target={external ? "_blank" : undefined}
              rel={external ? "noopener" : undefined}
              class="no-underline group-hover:text-ember-deep after:absolute after:inset-0"
            >
              {title}
            </a>
          </h3>
          <div class="mt-2">
            <StatusPill status={status} />
          </div>
        </div>
        {githubUrl && (
          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="relative z-10 grid size-10 shrink-0 place-items-center rounded-full border-[1.5px] border-line text-ink-70 hover:border-ink hover:text-ink"
            title={`View ${title} on GitHub`}
          >
            <IconGitHub class="size-5" />
            <span class="sr-only">View {title} on GitHub</span>
          </a>
        )}
      </div>
      <p class="mt-4 flex-grow text-[15px] leading-relaxed text-ink-70">
        {description}
      </p>
      {tags.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Technologies">
          {tags.map(t => (
            <li class="tag">{t}</li>
          ))}
        </ul>
      )}
      <div class="mt-5 flex flex-wrap items-center gap-4 border-t border-line pt-4 text-sm font-bold">
        <span class="text-ember-deep">
          {linkLabel} {external ? "↗" : "→"}
        </span>
        {!external && liveUrl && (
          <a
            href={liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="relative z-10 text-ink-70 hover:text-ink"
          >
            {liveLabel ?? "Live demo"} ↗
          </a>
        )}
      </div>
    </article>
  )
}
