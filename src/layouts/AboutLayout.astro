---
// src/layouts/AboutLayout.astro
import Layout from "./Layout.astro";
import PageHeader from "@/components/PageHeader.astro";
import { SITE } from "@/config";

export interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
---

<Layout title={`${frontmatter.title} | ${SITE.title}`}>
  <PageHeader eyebrow="Story" title={frontmatter.title} />
  <div class="container-x grid gap-12 pb-24 lg:grid-cols-[1fr_300px]">
    <article id="about" class="prose-avail prose">
      <slot />
    </article>
    <aside class="hidden lg:block">
      <div class="sticky top-24">
        <div class="relative mx-auto w-fit">
          <span
            class="ring-motif -inset-5 border-[16px] border-ember-tint"
            aria-hidden="true"></span>
          <img
            src="/images/profile.png"
            alt="Portrait of Emmanuel Buruvuru"
            width="260"
            height="260"
            class="relative size-64 rounded-full border-[6px] border-ember object-cover"
          />
        </div>
      </div>
    </aside>
  </div>
</Layout>
