---
// src/pages/projects/[slug].astro
import Layout from "@/layouts/Layout.astro";
import StatusPill from "@/components/StatusPill.astro";
import { projects } from "@/data/projects";
import { SITE } from "@/config";

export function getStaticPaths() {
  // External projects (e.g. Avail Africa) link straight to their own site.
  return projects
    .filter(project => !project.external)
    .map(project => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const accentBg =
  project.accent === "sprint" ? "bg-sprint-tint" : "bg-ember-tint";
const sections = [
  { title: "The problem", body: project.problem },
  { title: "The approach", body: project.approach },
].filter(s => s.body);
---

<Layout
  title={`${project.title} | ${SITE.title}`}
  description={project.description}
>
  <section class:list={["relative overflow-hidden", accentBg]}>
    <span
      class="ring-motif -top-40 -right-44 size-[520px] border-[84px] border-white/50"
      aria-hidden="true"></span>
    <div class="relative container-x pt-10 pb-14 sm:pt-14">
      <a
        href="/projects"
        class="text-[15px] font-bold text-ink no-underline hover:underline"
        >← All projects</a
      >
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <h1
          class="text-[40px] leading-[1.04] font-extrabold tracking-[-0.025em] sm:text-6xl"
        >
          {project.title}
        </h1>
        <StatusPill status={project.status} />
      </div>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-70">
        {project.description}
      </p>

      {
        project.tags && project.tags.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-2" aria-label="Technologies">
            {project.tags.map(tag => (
              <li class="pill">{tag}</li>
            ))}
          </ul>
        )
      }

      {
        (project.githubUrl || project.liveUrl || project.cta) && (
          <div class="mt-8 flex flex-wrap gap-3">
            {project.cta && (
              <a href={project.cta.href} class="btn-primary">
                {project.cta.label} <span aria-hidden="true">→</span>
              </a>
            )}
            {project.githubUrl && (
              <a
                href={project.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-ghost"
              >
                View source ↗
              </a>
            )}
            {project.liveUrl && (
              <a
                href={project.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-dark"
              >
                {project.liveLabel ?? "Live demo"} ↗
              </a>
            )}
          </div>
        )
      }
    </div>
  </section>

  <div class="container-x py-14 sm:py-20">
    {
      project.embed && (
        <div class="mb-14">
          <h2 class="text-[28px] font-bold">Interactive demo</h2>
          <p class="mt-2 mb-5 text-ink-70">
            Tap the left or right side of the screen (or use the controls) to
            move through the app.
          </p>
          <iframe
            src={project.embed.src}
            title={project.embed.title}
            loading="lazy"
            class="w-full rounded-[24px] border-[1.5px] border-line bg-[#063D2E]"
            style="height: min(760px, 82vh); min-height: 520px;"
          />
        </div>
      )
    }

    <div class="grid gap-10 lg:grid-cols-[1.4fr_1fr]">
      <div class="space-y-10">
        {
          sections.map(s => (
            <div>
              <h2 class="flex items-center gap-3 text-[28px] font-bold">
                <span class="dot" aria-hidden="true" />
                {s.title}
              </h2>
              <p class="mt-3 text-[17px] leading-[1.7] text-ink-70">{s.body}</p>
            </div>
          ))
        }
        {
          project.highlights && project.highlights.length > 0 && (
            <div>
              <h2 class="flex items-center gap-3 text-[28px] font-bold">
                <span class="dot" aria-hidden="true" />
                Highlights
              </h2>
              <ul class="mt-4 space-y-3">
                {project.highlights.map(item => (
                  <li class="flex gap-3 text-[17px] leading-relaxed text-ink-70">
                    <span
                      class="mt-2.5 size-2 shrink-0 rounded-full bg-ember"
                      aria-hidden="true"
                    />
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
      <aside class="space-y-5 lg:sticky lg:top-24 lg:self-start">
        {
          project.role && (
            <div class="card">
              <h2 class="eyebrow text-ink-70">My role</h2>
              <p class="mt-3 text-[17px] leading-relaxed">{project.role}</p>
            </div>
          )
        }
        {
          project.note && (
            <div class="rounded-[24px] bg-ink p-6 text-paper sm:p-8">
              <p class="leading-relaxed text-ink-soft">{project.note}</p>
            </div>
          )
        }
      </aside>
    </div>
  </div>
</Layout>
