---
// src/pages/404.astro
import Layout from "@/layouts/Layout.astro";
import { SITE } from "@/config";
---

<Layout title={`404 – Page Not Found | ${SITE.title}`}>
  <section class="relative flex flex-1 items-center overflow-hidden">
    <span
      class="ring-motif -top-40 -right-44 size-[520px] border-[84px] border-ember/10"
      aria-hidden="true"></span>
    <div class="relative container-x py-28 text-center">
      <p
        class="font-display text-[120px] leading-none font-extrabold tracking-[-0.04em] text-ember"
      >
        404
      </p>
      <h1 class="mt-4 text-3xl font-bold sm:text-4xl">
        Oops — the page you’re looking for doesn’t exist.
      </h1>
      <p class="mx-auto mt-3 max-w-md text-lg text-ink-70">
        It may have been moved or removed. Try heading back home or using the
        menu above.
      </p>
      <a href="/" class="mt-8 btn-dark">← Back to Home</a>
    </div>
  </section>
</Layout>
