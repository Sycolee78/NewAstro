---
// src/pages/certifications.astro
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/PageHeader.astro";
import { certifications } from "@/data/certifications";
import { SITE } from "@/config";

const certs = certifications.filter(
  c => (c.kind ?? "certification") === "certification"
);
const training = certifications.filter(c => c.kind === "training");

const groups = [
  {
    heading: "Certifications",
    blurb:
      "Verified credentials across cloud architecture, AI, networking, and security.",
    items: certs,
  },
  {
    heading: "Training & courses",
    blurb:
      "Instructor-led courses I've completed, with certificates of completion.",
    items: training,
  },
].filter(g => g.items.length > 0);
---

<Layout
  title={`Certifications | ${SITE.title}`}
  description="Verified certifications and completed training courses held by Emmanuel Buruvuru, including Oracle Cloud Infrastructure and Cisco credentials."
>
  <PageHeader eyebrow="Credentials" title="Certifications & training">
    <p>
      Credentials and completed courses. Select any item to view the original
      certificate.
    </p>
  </PageHeader>

  <div class="container-x space-y-16 pb-24">
    {
      groups.map(group => (
        <section>
          <h2 class="text-[28px] font-bold">{group.heading}</h2>
          <p class="mt-1 mb-7 text-ink-70">{group.blurb}</p>
          <div class="grid gap-5 md:grid-cols-2">
            {group.items.map(cert => (
              <article class="flex flex-col card">
                <div class="flex flex-wrap items-center justify-between gap-3">
                  <span class="pill !py-1 !text-xs !font-bold">
                    {cert.issuer}
                  </span>
                  <span class="eyebrow text-ink-70">
                    {cert.kind === "training" ? "Completed" : "Issued"}{" "}
                    {cert.issued}
                  </span>
                </div>
                <h3 class="mt-4 text-xl leading-snug font-bold">
                  {cert.title}
                </h3>
                <dl class="mt-3 space-y-1 text-[15px] text-ink-70">
                  {cert.validUntil && (
                    <div class="flex gap-2">
                      <dt class="font-bold text-ink">Valid until:</dt>
                      <dd>{cert.validUntil}</dd>
                    </div>
                  )}
                  {cert.hours && (
                    <div class="flex gap-2">
                      <dt class="font-bold text-ink">Duration:</dt>
                      <dd>{cert.hours}</dd>
                    </div>
                  )}
                  {cert.credentialId && (
                    <div class="flex flex-wrap gap-2">
                      <dt class="font-bold text-ink">Credential ID:</dt>
                      <dd class="break-all">{cert.credentialId}</dd>
                    </div>
                  )}
                </dl>
                <a
                  href={cert.file}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-6 btn-ghost !min-h-11 self-start !px-5 !text-sm"
                  aria-label={`View the ${cert.title} certificate (opens PDF in a new tab)`}
                >
                  View certificate <span aria-hidden="true">→</span>
                </a>
              </article>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Layout>
