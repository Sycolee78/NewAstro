---
// src/pages/index.astro
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Hr from "@/components/Hr.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { projects } from "@/data/projects";
import { certifications } from "@/data/certifications";
import { SOCIALS } from "@/constants";

const featuredProjects = projects.filter(p => p.featured).slice(0, 3);
const resumeHref = "/assets/Buruvuru-Emmanuel-Resume.pdf";
const stravaUrl = "https://www.strava.com/athletes/132983852";

// How engineering and athletics reinforce each other — grounded in the About page.
const principles = [
  {
    title: "Discipline",
    body: "Progress in badminton and running comes from showing up on the days it's hard. I bring the same steady, deliberate habit to shipping and maintaining software.",
  },
  {
    title: "Consistency",
    body: "I track, iterate, and optimize my training the same way I approach code — small, compounding improvements over time beat unsustainable sprints.",
  },
  {
    title: "Performance under pressure",
    body: "Competition teaches you to stay composed when it counts. In engineering that means clear thinking during incidents, reviews, and deadlines.",
  },
];

// Skill groups — a focused set I'm comfortable being grilled on (not an exhaustive list).
const skillGroups = [
  {
    title: "Languages",
    skills: ["Java", "Python", "TypeScript"],
  },
  {
    title: "Backend & APIs",
    skills: ["Spring Boot", "Node.js", "REST APIs", "PostgreSQL", "MongoDB"],
  },
  {
    title: "Data & AI",
    skills: ["ETL Pipelines", "RAG", "Vectorization", "Machine Learning"],
  },
  {
    title: "Cloud & DevOps",
    skills: ["Oracle Cloud", "AWS", "Docker", "CI/CD"],
  },
];

// Experience — sourced directly from the résumé (roles, dates, and metrics).
const experience = [
  {
    period: "Jul 2025 – Present",
    role: "Software Engineer",
    org: "Africa Clinical Research Network",
    bullets: [
      "Build operational applications that process 5,000+ clinical records per day.",
      "Deliver integrations across 10+ ERP modules, cutting manual processing by ~40%.",
      "Design data pipelines and ETL workflows that improve data accuracy and processing speed.",
    ],
  },
  {
    period: "Jun 2024 – Jun 2025",
    role: "Software Developer / Associate Cybersecurity Engineer",
    org: "Ignite Africa",
    bullets: [
      "Developed reporting automations and conducted security assessments across 4 companies, remediating 50+ critical vulnerabilities before deployment.",
      "Built Power Apps for business continuity and reduced incidents by 30–40% across 1000+ endpoints using Check Point and Rapid7.",
    ],
  },
  {
    period: "Feb 2023 – Nov 2023",
    role: "Software Engineer",
    org: "Accenture (Part-Time Project)",
    bullets: [
      "Built full-stack application features using Spring Boot, MongoDB, Node.js, and modern frontend technologies.",
      "Developed and deployed secure internal learning-platform modules, improving reliability, usability, and deployment workflows.",
    ],
  },
];

// Education — sourced directly from the résumé.
const education = {
  school: "Curtin University",
  degree: "BSc, Information Technology",
  year: "2024",
};

// Show a preview of certifications on the homepage; the full list lives on /certifications.
const certPreview = certifications.slice(0, 3);
---

<Layout
  title="Emmanuel Buruvuru — Software Engineer"
  description="Emmanuel Buruvuru is a software engineer focused on backend, data, and AI-driven systems — and a competitive badminton and running athlete who brings the same discipline to building reliable software."
>
  <Header />

  <main id="main-content" data-layout="index">
    <!-- Hero -->
    <section id="hero" class="pt-28 pb-14 sm:pt-32">
      <div class="flex flex-col-reverse items-start gap-8 sm:flex-row sm:items-center sm:justify-between">
        <div class="reveal max-w-xl">
          <p class="font-semibold tracking-wide text-blue-600 dark:text-orange-400">
            Software Engineer <span aria-hidden="true">×</span> Athlete
          </p>
          <h1 class="my-3 inline-block text-4xl font-bold sm:my-4 sm:text-5xl typewriter">
            Emmanuel Buruvuru
          </h1>
          <h2 class="mb-5 text-xl font-semibold text-foreground/80 sm:text-2xl">
            Software Engineer — Backend, Data &amp; AI
          </h2>
          <p class="max-w-xl leading-relaxed text-foreground/80">
            I build reliable backend and data systems — from full-stack platforms to
            production data pipelines — with a security-minded approach and the same
            discipline competitive sport demands.
          </p>

          <div class="mt-7 flex flex-wrap items-center gap-3">
            <a
              href="#featured-projects"
              class="rounded-md bg-accent px-5 py-2.5 text-sm font-semibold text-background transition hover:opacity-90"
            >
              View Projects
            </a>
            <a
              href={resumeHref}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-md border border-current px-5 py-2.5 text-sm font-semibold transition hover:bg-accent hover:text-background"
            >
              Download Résumé
            </a>
          </div>

          {SOCIALS.length > 0 && (
            <div class="mt-6 flex items-center gap-2">
              <span class="whitespace-nowrap text-sm text-foreground/70">Find me on</span>
              <Socials />
            </div>
          )}
        </div>

        <div class="shrink-0">
          <img
            src="/images/profile.png"
            alt="Portrait of Emmanuel Buruvuru"
            width="176"
            height="176"
            class="size-32 rounded-full border-4 border-blue-500 object-cover shadow-lg sm:size-44 dark:border-orange-400"
          />
        </div>
      </div>
    </section>

    <Hr />

    <!-- Positioning: where engineering meets athletics -->
    <section id="ethos" class="py-12">
      <h2 class="text-2xl font-semibold tracking-wider sm:text-3xl">
        Engineering discipline, athletic mindset
      </h2>
      <p class="mt-3 max-w-2xl text-foreground/80">
        I don't treat software and sport as separate lives. The habits that make me
        a better athlete make me a better engineer — and the reverse is just as true.
      </p>

      <div class="mt-8 grid gap-5 sm:grid-cols-3">
        {principles.map(item => (
          <div class="rounded-lg border border-border p-6 transition hover:border-accent/60 hover:shadow-md">
            <h3 class="text-lg font-semibold text-blue-600 dark:text-orange-400">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-foreground/80">{item.body}</p>
          </div>
        ))}
      </div>
    </section>

    <Hr />

    <!-- Engineering expertise -->
    <section id="engineering" class="py-12">
      <h2 class="text-2xl font-semibold tracking-wider sm:text-3xl">
        Engineering expertise
      </h2>
      <p class="mt-3 max-w-2xl text-foreground/80">
        The core of what I build with day to day — backend services, data pipelines,
        and the cloud they run on.
      </p>

      <div class="mt-8 grid gap-5 sm:grid-cols-2">
        {skillGroups.map(group => (
          <div class="rounded-lg border border-border p-6">
            <h3 class="mb-3 text-lg font-semibold">{group.title}</h3>
            <ul class="flex flex-wrap gap-2">
              {group.skills.map(skill => (
                <li class="rounded-md bg-muted px-2.5 py-1 text-xs font-medium text-foreground/80">
                  {skill}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <p class="mt-4 text-sm text-foreground/60">
        Also comfortable with React, and security tooling (Check Point, Rapid7,
        Microsoft Intune) from my cybersecurity work.
      </p>
    </section>

    <Hr />

    <!-- Featured projects -->
    <section id="featured-projects" class="py-12">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-2xl font-semibold tracking-wider sm:text-3xl">
          Featured work
        </h2>
        <a
          href="/projects"
          class="text-sm font-medium text-blue-600 hover:underline dark:text-orange-400"
        >
          View all projects →
        </a>
      </div>

      <div class="mt-8 grid gap-6 lg:grid-cols-2">
        {featuredProjects.map(project => (
          <ProjectCard
            title={project.title}
            status={project.status}
            description={project.description}
            slug={project.slug}
            githubUrl={project.githubUrl}
            liveUrl={project.liveUrl}
            tags={project.tags}
          />
        ))}
      </div>
    </section>

    <Hr />

    <!-- Athletic journey -->
    <section id="athletics" class="py-12">
      <h2 class="text-2xl font-semibold tracking-wider sm:text-3xl">
        Athletic journey
      </h2>
      <p class="mt-3 max-w-2xl text-foreground/80">
        I train with the mindset of a competitive athlete — badminton is my
        competitive edge, and running builds the aerobic base and mental toughness
        that carry into everything else.
      </p>

      <div class="mt-8 grid gap-5 sm:grid-cols-3">
        <div class="rounded-lg border border-border p-6">
          <h3 class="text-lg font-semibold text-blue-600 dark:text-orange-400">Badminton</h3>
          <p class="mt-2 text-sm text-foreground/80">
            Competitive singles training with a clear target ahead.
          </p>
          <p class="mt-3 text-xs font-medium uppercase tracking-wide text-foreground/60">
            Goal — Mauritian Open 2026
          </p>
        </div>
        <div class="rounded-lg border border-border p-6">
          <h3 class="text-lg font-semibold text-blue-600 dark:text-orange-400">Running</h3>
          <p class="mt-2 text-sm text-foreground/80">
            Building aerobic base and consistency — tracked and iterated on like any
            other performance system.
          </p>
        </div>
        <div class="rounded-lg border border-border p-6">
          <h3 class="text-lg font-semibold text-blue-600 dark:text-orange-400">Traits it builds</h3>
          <p class="mt-2 text-sm text-foreground/80">
            Focus, resilience, and consistency under pressure — the same qualities I
            bring to engineering teams.
          </p>
        </div>
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={stravaUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 rounded-lg bg-[#FC4C02] px-5 py-3 font-medium text-white transition-all hover:bg-[#E34402] hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-[#FC4C02] focus:ring-offset-2 focus:ring-offset-background"
          aria-label="Follow my training journey on Strava"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169"/>
          </svg>
          Follow on Strava
        </a>
        <a
          href="https://instagram.com/emmanuel.buruvuru"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 rounded-lg border border-current px-5 py-3 font-medium transition hover:bg-accent hover:text-background"
          aria-label="Follow me on Instagram"
        >
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          Follow on Instagram
        </a>
      </div>
    </section>

    <Hr />

    <!-- Experience -->
    <section id="experience" class="py-12">
      <h2 class="text-2xl font-semibold tracking-wider sm:text-3xl">
        Experience
      </h2>
      <p class="mt-3 max-w-2xl text-foreground/80">
        From enterprise full-stack engineering to cybersecurity to building
        data-driven systems in production.
      </p>

      <ol class="mt-8 space-y-6">
        {experience.map(job => (
          <li class="relative rounded-lg border border-border p-6">
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
              <h3 class="text-lg font-semibold">
                {job.role} <span class="text-foreground/60">· {job.org}</span>
              </h3>
              <span class="shrink-0 text-xs font-medium uppercase tracking-wide text-foreground/60">
                {job.period}
              </span>
            </div>
            <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-foreground/80 marker:text-accent">
              {job.bullets.map(point => (
                <li>{point}</li>
              ))}
            </ul>
          </li>
        ))}
      </ol>

      <!-- Education & certifications -->
      <div class="mt-8 grid gap-5 sm:grid-cols-2">
        <div class="rounded-lg border border-border p-6">
          <h3 class="text-sm font-semibold uppercase tracking-wide text-foreground/60">Education</h3>
          <p class="mt-2 font-semibold">{education.degree}</p>
          <p class="text-sm text-foreground/80">{education.school} · {education.year}</p>
        </div>
        <div class="rounded-lg border border-border p-6">
          <div class="flex items-baseline justify-between gap-3">
            <h3 class="text-sm font-semibold uppercase tracking-wide text-foreground/60">Certifications</h3>
            <a
              href="/certifications"
              class="text-xs font-medium text-blue-600 hover:underline dark:text-orange-400"
            >
              View all →
            </a>
          </div>
          <ul class="mt-2 space-y-1.5 text-sm text-foreground/80">
            {certPreview.map(cert => (
              <li>{cert.title} <span class="text-foreground/50">· {cert.issuer}</span></li>
            ))}
          </ul>
        </div>
      </div>

      <a
        href="/about"
        class="mt-6 inline-block text-sm font-medium text-blue-600 hover:underline dark:text-orange-400"
      >
        Read the full story →
      </a>
    </section>

    <Hr />

    <!-- Contact -->
    <section id="contact" class="py-12">
      <h2 class="text-2xl font-semibold tracking-wider sm:text-3xl">
        Let's work together
      </h2>
      <p class="mt-3 max-w-2xl text-foreground/80">
        I'm open to conversations about interesting problems and ambitious projects, including:
      </p>

      <ul class="mt-5 grid gap-2 text-sm text-foreground/80 sm:grid-cols-2">
        <li class="rounded-md bg-muted/60 px-3 py-2">Software engineering roles</li>
        <li class="rounded-md bg-muted/60 px-3 py-2">Technical consulting &amp; security</li>
        <li class="rounded-md bg-muted/60 px-3 py-2">Product collaborations</li>
        <li class="rounded-md bg-muted/60 px-3 py-2">Sports partnerships &amp; sponsorships</li>
      </ul>

      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a
          href="mailto:emmanuelburuvuru@gmail.com"
          class="rounded-md bg-accent px-5 py-2.5 text-sm font-semibold text-background transition hover:opacity-90"
        >
          Email me
        </a>
        <a
          href="https://www.linkedin.com/in/emmanuel-buruvuru-a20b46246/"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-md border border-current px-5 py-2.5 text-sm font-semibold transition hover:bg-accent hover:text-background"
        >
          Connect on LinkedIn
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
